# ============================================
#   buzz_monitor - GitIgnore
# Includes relevant files/directories up to v.0.2.0, including alpha testing v.0.1.0-alpha
# ============================================

# --------------------------------------------
# PYTHON: Compiled files and bytecode
# --------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# --------------------------------------------
# PYTHON: Packaging and build directories
# --------------------------------------------
build/
dist/
*.egg-info/
.eggs/
MANIFEST

# --------------------------------------------
# ENVIRONMENTS: Virtualenvs and pip caches
# --------------------------------------------
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# --------------------------------------------
# DATA: Audio logs, processed data, and CSVs
# --------------------------------------------
data/
data/recordings/
data/processed/
*.wav
*.flac
*.csv

# --------------------------------------------
# RUNTIME: Logs, temp, and state files
# --------------------------------------------
logs/
*.log
*.tmp
*.bak
*.pid
*.state

# --------------------------------------------
# SCRIPTS: Local or generated shell helpers
# --------------------------------------------
# Keep setup.sh tracked; ignore user-specific scripts
run_monitor.sh
setup_local.sh
*.local.sh
*.env.local

# --------------------------------------------
# C++: Build artifacts and intermediate objects
# --------------------------------------------
src/*.o
src/*.out
src/*.exe
src/*.a
src/*.so
src/*.dll
src/*.dylib
src/*.obj
src/*.pdb

# --------------------------------------------
# C++: Build systems (CMake, Make)
# --------------------------------------------
build-*/
Makefile
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# --------------------------------------------
# TELEMETRY: Local credentials and configs
# --------------------------------------------
grafana.ini
influxdb.conf
config_local.json
secrets.json

# --------------------------------------------
# DOCS: Generated documentation or previews
# --------------------------------------------
docs/_build/
docs/_site/
docs/build/
*.html
*.pdf

# --------------------------------------------
# IDEs & EDITORS: Local project settings
# --------------------------------------------
.DS_Store
.vscode/
.idea/
*~
.spyproject
.ropeproject
.pybuilder/
.pytype/
.mypy_cache/
.ruff_cache/

# --------------------------------------------
# JUPYTER: Notebook checkpoint files
# --------------------------------------------
.ipynb_checkpoints/
